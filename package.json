{
  "name": "ptv-webos-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native PiggieTV webOS TV client with direct Jellyfin API integration",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "package": "npm run build && node scripts/package-webos.cjs",
    "package:inspect": "node scripts/inspect-webos-package.cjs",
    "package:inspect:detail": "node scripts/inspect-webos-package.cjs --detail",
    "clean": "if exist .cache rmdir /s /q .cache && if exist dist rmdir /s /q dist && if exist build rmdir /s /q build && if exist coverage rmdir /s /q coverage",
    "docs": "echo 'Documentation in docs/ directory'",
    "webos:device:add": "ares-setup-device",
    "webos:devices": "node scripts/webos-inspect.cjs --list",
    "webos:device:info": "node scripts/webos-device-info.cjs",
    "webos:package": "npm run build && node scripts/package-webos.cjs",
    "webos:install": "node scripts/webos-install.cjs",
    "webos:remove": "node scripts/webos-remove.cjs",
    "webos:launch": "node scripts/webos-launch.cjs",
    "webos:close": "node scripts/webos-launch.cjs --close",
    "webos:logs": "node scripts/webos-logs.cjs",
    "webos:launch:hosted": "npm run build && node scripts/webos-launch-hosted.cjs",
    "webos:inspect": "node scripts/webos-inspect.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.0.4",
    "vitest": "^2.1.8"
  }
}
